/**
 * Copies packages/core/src into supabase/functions/_shared/core (§2) so the edge functions run the
 * exact validation, redaction and hashing code the app runs. Deno needs explicit `.ts` extensions,
 * so relative imports are rewritten on the way. Run with: node scripts/sync-shared.mts
 */
import { mkdirSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = join(dirname(fileURLToPath(import.meta.url)), '..');
const source = join(root, 'packages', 'core', 'src');
const target = join(root, 'supabase', 'functions', '_shared', 'core');

const HEADER = '// GENERATED by scripts/sync-shared.mts from packages/core/src. Do not edit; edit the source and re-run.\n';
const RELATIVE_IMPORT = /(from\s+['"])(\.{1,2}\/[^'"]+?)(?<!\.ts)(['"])/g;

export function toDeno(code: string): string {
  return HEADER + code.replace(RELATIVE_IMPORT, '$1$2.ts$3');
}

function sync(): void {
  rmSync(target, { recursive: true, force: true });
  mkdirSync(target, { recursive: true });
  const files = readdirSync(source).filter((f) => f.endsWith('.ts') && !f.endsWith('.test.ts'));
  for (const file of files) {
    writeFileSync(join(target, file), toDeno(readFileSync(join(source, file), 'utf8')));
  }
  process.stdout.write(`synced ${files.length} core files -> ${target}\n`);
}

sync();
