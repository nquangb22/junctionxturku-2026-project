# Edge function secrets. Copy to supabase/functions/.env for `supabase functions serve`, and set them on the
# hosted project with `supabase secrets set --env-file supabase/functions/.env`. Never commit the real file.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.
ANTHROPIC_API_KEY=
# At least 32 random characters, shared with If out of band. Generate with: openssl rand -base64 48
IF_PARTNER_SECRET=
